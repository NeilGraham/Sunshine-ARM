From 24e52ab450e623a596c46fe7311beb2046ab5371 Mon Sep 17 00:00:00 2001
From: Neil Graham <grahamneiln@gmail.com>
Date: Fri, 3 Jul 2026 12:06:39 -0600
Subject: [PATCH] uhid/ds5: fix sign handling in to_le_signed for gyro/accel
 values

Passing the float straight to htole16's uint16_t parameter saturated
negative sensor values to 0, so half the DualSense motion range (all
negative gyro/accel readings) was lost. Cast through int16_t first so
negative values keep their two's-complement encoding.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 src/uhid/joypad_ps5.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/uhid/joypad_ps5.cpp b/src/uhid/joypad_ps5.cpp
index 8a03fac..83a2f0a 100644
--- a/src/uhid/joypad_ps5.cpp
+++ b/src/uhid/joypad_ps5.cpp
@@ -506,7 +506,10 @@ void PS5Joypad::set_on_rumble(const std::function<void(int, int)> &callback) {
  */
 static __le16 to_le_signed(float original, float value) {
   value = std::clamp(value, static_cast<float>(SHRT_MIN), static_cast<float>(SHRT_MAX));
-  return htole16(value);
+  // Convert through int16_t so negative samples keep their sign bit pattern;
+  // passing the float straight to htole16's uint16_t parameter saturates
+  // negatives to 0 on ARM (gyro/accel could aim up/left but never down/right).
+  return htole16(static_cast<int16_t>(value));
 }
 
 void PS5Joypad::set_motion(PS5Joypad::MOTION_TYPE type, float x, float y, float z) {
