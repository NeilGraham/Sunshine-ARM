diff --git a/libavcodec/rkmppenc.c b/libavcodec/rkmppenc.c
index 6837a79..ea4901b 100644
--- a/libavcodec/rkmppenc.c
+++ b/libavcodec/rkmppenc.c
@@ -716,6 +716,190 @@ static int rkmpp_prepare_udu_sei_data(AVCodecContext *avctx, MPPEncFrame *mpp_en
     return 0;
 }
 
+/*
+ * Track the enabled OSD region geometry and force an IDR whenever it
+ * changes (including to/from "none"). The blend is clean at the encoder —
+ * verified: absent side data stops rendering within one frame — but the
+ * few frames that repaint a vacated area are ordinary P-frames; if the
+ * link drops them, a receiver keeps the stale overlay in its references
+ * indefinitely (static blocks SKIP forever). One keyframe per overlay
+ * transition makes that impossible.
+ */
+static int rkmpp_osd_geometry_changed(AVCodecContext *avctx, uint32_t hash)
+{
+    RKMPPEncContext *r = avctx->priv_data;
+    MPP_RET ret;
+
+    if (hash == r->osd_geom_hash)
+        return 0;
+    r->osd_geom_hash = hash;
+
+    if ((ret = r->mapi->control(r->mctx, MPP_ENC_SET_IDR_FRAME, NULL)) != MPP_OK)
+        av_log(avctx, AV_LOG_WARNING,
+               "Failed to request IDR for OSD transition: %d\n", ret);
+    return 0;
+}
+
+/*
+ * No (usable) side data on this frame. Fire the transition IDR if OSD was
+ * showing, and — once OSD has ever been used — attach an explicit
+ * all-disabled region set instead of leaving the meta key absent, so the
+ * HAL writes osd_e = 0 on every MPP vintage (see osd_ever_used).
+ */
+static int rkmpp_osd_clear(AVCodecContext *avctx, MPPEncFrame *mpp_enc_frame)
+{
+    RKMPPEncContext *r = avctx->priv_data;
+    MppEncOSDData2 *dst = &mpp_enc_frame->mpp_osd;
+    MppMeta mpp_meta;
+    MPP_RET ret;
+
+    rkmpp_osd_geometry_changed(avctx, 0);
+
+    if (!r->osd_ever_used)
+        return 0;
+
+    memset(dst, 0, sizeof(*dst));
+    dst->num_region = 1; /* region[0]: enable = 0, zero geometry, no buffer */
+
+    mpp_meta = mpp_frame_get_meta(mpp_enc_frame->mpp_frame);
+    if (!mpp_meta) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to get frame meta\n");
+        return AVERROR_EXTERNAL;
+    }
+    if ((ret = mpp_meta_set_ptr(mpp_meta, KEY_OSD_DATA2, dst)) != MPP_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to set the OSD clear ptr\n");
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+static int rkmpp_prepare_osd_data(AVCodecContext *avctx, MPPEncFrame *mpp_enc_frame)
+{
+    RKMPPEncContext *r = avctx->priv_data;
+    const RKMPPOsdSideData *osd;
+    MppEncOSDData2 *dst = &mpp_enc_frame->mpp_osd;
+    AVFrameSideData *sd;
+    MppBuffer mpp_buf = NULL;
+    MppMeta mpp_meta;
+    uint32_t i;
+    int ret, slot = -1;
+
+    sd = av_frame_get_side_data(mpp_enc_frame->frame, AV_FRAME_DATA_RKMPP_OSD);
+    if (!sd)
+        return rkmpp_osd_clear(avctx, mpp_enc_frame);
+
+    if (sd->size < sizeof(*osd)) {
+        av_log(avctx, AV_LOG_WARNING, "Invalid RKMPP OSD side data: "
+               "(%"SIZE_SPECIFIER" < %"SIZE_SPECIFIER"), skipping\n",
+               sd->size, sizeof(*osd));
+        return rkmpp_osd_clear(avctx, mpp_enc_frame);
+    }
+    osd = (const RKMPPOsdSideData *)sd->data;
+
+    if (!osd->num_region || osd->num_region > RKMPP_OSD_MAX_REGIONS ||
+        osd->fd < 0 || !osd->size)
+        return rkmpp_osd_clear(avctx, mpp_enc_frame);
+
+    {
+        uint32_t hash = 2166136261u;
+        for (i = 0; i < osd->num_region; i++) {
+            const uint32_t geom[5] = {
+                osd->region[i].enable, osd->region[i].start_mb_x,
+                osd->region[i].start_mb_y, osd->region[i].num_mb_x,
+                osd->region[i].num_mb_y,
+            };
+            const uint8_t *b = (const uint8_t *)geom;
+            size_t k;
+            for (k = 0; k < sizeof(geom); k++)
+                hash = (hash ^ b[k]) * 16777619u;
+        }
+        if (!hash)
+            hash = 1;
+        ret = rkmpp_osd_geometry_changed(avctx, hash);
+        if (ret < 0)
+            return ret;
+    }
+
+    /* the palette is applied through the control path, only on change */
+    if (!r->osd_plt_set || osd->palette_serial != r->osd_plt_serial) {
+        MppEncOSDPltCfg plt_cfg = { 0 };
+        MppEncOSDPlt plt;
+
+        /* MPP deep-copies the palette during the control call */
+        memcpy(plt.data, osd->palette, sizeof(plt.data));
+        plt_cfg.change = MPP_ENC_OSD_PLT_CFG_CHANGE_ALL;
+        plt_cfg.type = MPP_ENC_OSD_PLT_TYPE_USERDEF;
+        plt_cfg.plt = &plt;
+
+        if ((ret = r->mapi->control(r->mctx, MPP_ENC_SET_OSD_PLT_CFG,
+                                    &plt_cfg)) != MPP_OK) {
+            av_log(avctx, AV_LOG_ERROR, "Failed to set OSD palette: %d\n", ret);
+            return AVERROR_EXTERNAL;
+        }
+        r->osd_plt_serial = osd->palette_serial;
+        r->osd_plt_set = 1;
+    }
+
+    /* surfaces are long-lived: import each distinct (fd, size) only once */
+    for (i = 0; i < FF_ARRAY_ELEMS(r->osd_imports); i++) {
+        if (r->osd_imports[i].buf &&
+            r->osd_imports[i].fd == osd->fd &&
+            r->osd_imports[i].size == osd->size) {
+            mpp_buf = r->osd_imports[i].buf;
+            break;
+        }
+        if (slot < 0 && !r->osd_imports[i].buf)
+            slot = i;
+    }
+    if (!mpp_buf) {
+        MppBufferInfo buf_info = { 0 };
+
+        buf_info.type  = MPP_BUFFER_TYPE_DRM;
+        buf_info.fd    = osd->fd;
+        buf_info.size  = osd->size;
+        buf_info.index = buf_info.fd;
+
+        if ((ret = mpp_buffer_import(&mpp_buf, &buf_info)) != MPP_OK) {
+            av_log(avctx, AV_LOG_ERROR, "Failed to import OSD buffer: %d\n", ret);
+            return AVERROR_EXTERNAL;
+        }
+        if (slot < 0) { /* all slots busy: recycle the first */
+            slot = 0;
+            mpp_buffer_put(r->osd_imports[0].buf);
+        }
+        r->osd_imports[slot].fd   = osd->fd;
+        r->osd_imports[slot].size = osd->size;
+        r->osd_imports[slot].buf  = mpp_buf;
+    }
+
+    r->osd_ever_used = 1;
+
+    memset(dst, 0, sizeof(*dst));
+    dst->num_region = osd->num_region;
+    for (i = 0; i < osd->num_region; i++) {
+        dst->region[i].enable     = osd->region[i].enable;
+        dst->region[i].inverse    = 0;
+        dst->region[i].start_mb_x = osd->region[i].start_mb_x;
+        dst->region[i].start_mb_y = osd->region[i].start_mb_y;
+        dst->region[i].num_mb_x   = osd->region[i].num_mb_x;
+        dst->region[i].num_mb_y   = osd->region[i].num_mb_y;
+        dst->region[i].buf_offset = osd->region[i].buf_offset;
+        dst->region[i].buf        = mpp_buf;
+    }
+
+    mpp_meta = mpp_frame_get_meta(mpp_enc_frame->mpp_frame);
+    if (!mpp_meta) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to get frame meta\n");
+        return AVERROR_EXTERNAL;
+    }
+    if ((ret = mpp_meta_set_ptr(mpp_meta, KEY_OSD_DATA2, dst)) != MPP_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to set the OSD data ptr\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    return 0;
+}
+
 static MPPEncFrame *rkmpp_submit_frame(AVCodecContext *avctx, AVFrame *frame)
 {
     RKMPPEncContext *r = avctx->priv_data;
@@ -900,6 +1084,13 @@ static MPPEncFrame *rkmpp_submit_frame(AVCodecContext *avctx, AVFrame *frame)
             goto exit;
     }
 
+    if (avctx->codec_id == AV_CODEC_ID_H264 ||
+        avctx->codec_id == AV_CODEC_ID_HEVC) {
+        ret = rkmpp_prepare_osd_data(avctx, mpp_enc_frame);
+        if (ret < 0)
+            goto exit;
+    }
+
     return mpp_enc_frame;
 
 exit:
@@ -1102,6 +1293,13 @@ static av_cold int rkmpp_encode_close(AVCodecContext *avctx)
 
     clear_frame_list(&r->frame_list);
 
+    for (int i = 0; i < FF_ARRAY_ELEMS(r->osd_imports); i++) {
+        if (r->osd_imports[i].buf) {
+            mpp_buffer_put(r->osd_imports[i].buf);
+            r->osd_imports[i].buf = NULL;
+        }
+    }
+
     if (r->hwframe)
         av_buffer_unref(&r->hwframe);
     if (r->hwdevice)
diff --git a/libavcodec/rkmppenc.h b/libavcodec/rkmppenc.h
index f266fa3..20bbf15 100644
--- a/libavcodec/rkmppenc.h
+++ b/libavcodec/rkmppenc.h
@@ -45,10 +45,36 @@
 #define MJPEG_ASYNC_FRAMES 8
 #define ALIGN_DOWN(a, b) ((a) & ~((b)-1))
 
+/*
+ * Payload of AV_FRAME_DATA_RKMPP_OSD frame side data. Byte-identical to
+ * struct rovl_osd_side_data in retro-overlay-protocol.h (the retro-stream
+ * overlay daemon's MIT protocol header) — that header cannot be included
+ * here, so the two definitions must be kept in sync in one commit.
+ */
+#define RKMPP_OSD_MAX_REGIONS 8
+#define RKMPP_OSD_PALETTE_SIZE 256
+
+typedef struct __attribute__((packed)) RKMPPOsdSideData {
+    int32_t  fd;        /* dma-buf of the palette-index surface */
+    uint32_t size;      /* dma-buf size in bytes */
+    uint32_t num_region;
+    struct __attribute__((packed)) {
+        uint32_t enable;
+        uint32_t start_mb_x; /* 16-px macroblock units */
+        uint32_t start_mb_y;
+        uint32_t num_mb_x;
+        uint32_t num_mb_y;
+        uint32_t buf_offset; /* bytes into the surface, 16-byte aligned */
+    } region[RKMPP_OSD_MAX_REGIONS];
+    uint32_t palette_serial; /* palette applied only when this changes */
+    uint32_t palette[RKMPP_OSD_PALETTE_SIZE]; /* (alpha<<24)|(v<<16)|(u<<8)|y */
+} RKMPPOsdSideData;
+
 typedef struct MPPEncFrame {
     AVFrame            *frame;
     MppFrame            mpp_frame;
     MppEncUserDataSet   mpp_sei_set;
+    MppEncOSDData2      mpp_osd;
     struct MPPEncFrame *next;
     int                 queued;
 } MPPEncFrame;
@@ -70,6 +96,26 @@ typedef struct RKMPPEncContext {
     MPPEncFrame       *frame_list;
     int                async_frames;
 
+    /* OSD dma-buf import cache + last applied palette serial */
+    struct {
+        int        fd;
+        uint32_t   size;
+        MppBuffer  buf;
+    }                  osd_imports[RKMPP_OSD_MAX_REGIONS];
+    uint32_t           osd_plt_serial;
+    int                osd_plt_set;
+    /* FNV-1a of the enabled region geometry; 0 = OSD inactive. An IDR is
+     * forced whenever this changes (appear/move/resize/disappear) so a
+     * client whose loss recovery misses the repaint frames can never keep
+     * a stale overlay in its reference pictures. */
+    uint32_t           osd_geom_hash;
+    /* Set once any OSD side data was consumed this session. From then on,
+     * frames WITHOUT side data get an explicit all-disabled region set:
+     * the Dec-2023 MPP this device ships latches the previous frame's OSD
+     * pointer in its task ring when the meta key is merely absent (proven
+     * with a system-library probe — the overlay re-blends forever). */
+    int                osd_ever_used;
+
     int                rc_mode;
     int                qp_init;
     int                qp_max;
