#ifndef __cpp_lib_format

#include <string>
#include <string_view>

#define FMT_HEADER_ONLY 1
#include <fmt/format.h>

namespace std {
  template<class... Args>
  string format(string_view fmt_str, Args &&...args) {
    return fmt::vformat(fmt_str, fmt::make_format_args(args...));
  }
}  // namespace std

#endif
